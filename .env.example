# Raven environment — copy to `.env` and edit. Dummy values only; never commit real secrets.
# Schema of record: packages/config/src/env.ts (19_DEPLOYMENT.md §1.1). Boot fails on invalid input.

# --- application mode ------------------------------------------------------
# APP_MODE=local is the default and needs NOTHING below this block: no database, no Redis, no S3,
# no auth secret. Everything is stored in the browser on this device. Registry and validation:
# packages/config/src/appMode.ts; rationale: docs/adr/ADR-001-local-first.md.
# APP_MODE=server turns the deployment on; the capability switches must then be set explicitly.
APP_MODE=local                              # local | server
# BACKEND_ENABLED=true                      # API + database (implied by APP_MODE=server)
# AUTH_ENABLED=true                         # accounts and sessions (requires BACKEND_ENABLED)
# GOOGLE_AUTH_ENABLED=false                 # Google sign-in (requires AUTH_ENABLED) — not built yet
# CLOUD_SYNC_ENABLED=false                  # device↔server sync (requires BACKEND_ENABLED) — P8
# REMOTE_DATABASE_ENABLED=true              # Postgres rather than device storage
# COLLABORATION_ENABLED=false               # live multi-user editing (requires CLOUD_SYNC_ENABLED)

# --- runtime ---------------------------------------------------------------
NODE_ENV=development                        # development | test | production
NEXUS_ENV=local                             # local | preview | staging | production
LOG_LEVEL=info                              # trace | debug | info | warn | error

# --- database --------------------------------------------------------------
DATABASE_URL=postgres://nexus:raven-dev-password@localhost:5432/raven   # Postgres 16 + pgvector
DATABASE_POOL_MAX=20                        # max pooled connections per service (2–200)

# --- redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379            # BullMQ queues + sync fanout

# --- object storage (MinIO locally, S3 in cloud) ---------------------------
S3_ENDPOINT=http://localhost:9000           # S3-compatible endpoint
S3_REGION=us-east-1                         # bucket region
S3_BUCKET=raven                             # bucket holding uploads and snapshots
S3_ACCESS_KEY_ID=raven-dev-access-key       # dummy: MinIO root user locally
S3_SECRET_ACCESS_KEY=raven-dev-secret-key   # dummy: MinIO root password locally
S3_FORCE_PATH_STYLE=true                    # true for MinIO, false for AWS S3

# --- auth ------------------------------------------------------------------
AUTH_SECRET=dev-only-auth-secret-change-me-32chars   # ≥32 chars; rotate per environment
AUTH_TRUSTED_ORIGINS=http://localhost:5173  # csv of origins allowed to hold a session cookie
PUBLIC_APP_URL=http://localhost:5173        # public URL of the SPA, used for links and CORS

# --- internal services -----------------------------------------------------
SYNC_URL=http://localhost:3002              # Hocuspocus sync service (arrives in P8)
SYNC_SHARED_SECRET=dev-only-sync-shared-secret-32chars   # API signs board tokens, sync verifies
RUNNER_URL=http://localhost:3003            # sandboxed tool runner (arrives in P9)
RUNNER_SHARED_SECRET=dev-only-runner-shared-secret-32ch  # API ↔ runner request signing

# --- egress ----------------------------------------------------------------
EGRESS_PROXY_URL=http://localhost:3128      # the only route to the internet for worker/runner
EGRESS_ALLOWLIST=api.github.com,raw.githubusercontent.com,objects.githubusercontent.com  # csv host allowlist

# --- AI --------------------------------------------------------------------
AI_PROVIDER=mock                            # mock | openai-compatible
AI_BASE_URL=https://api.example.invalid/v1  # OpenAI-compatible base URL (unused when mock)
AI_API_KEY=                                 # required when AI_PROVIDER is not mock
AI_MONTHLY_BUDGET_USD=50                    # hard spend ceiling per month

# --- credential storage ----------------------------------------------------
# 32 random bytes, base64: `openssl rand -base64 32`. Wraps every stored credential's DEK
# (15_SECURITY.md §8.2). Losing it makes stored credentials unreadable; rotate at the provider.
CREDENTIALS_MASTER_KEY=

# --- observability ---------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317   # OTLP collector; omit to log traces to console
OTEL_SERVICE_NAME=raven-api                 # per-service name, overridden in compose/k8s

# --- feature switches ------------------------------------------------------
NEXUS_TEST_ENDPOINTS=false                  # /api/test/* — must stay false in production
NEXUS_INTEGRATIONS_MODE=stub                # real | stub — stub keeps tools off the network
FEATURE_FLAGS=                              # csv of enabled flag names (19_DEPLOYMENT.md §9)

# --- docker compose only (infra/docker-compose.yml) ------------------------
POSTGRES_PASSWORD=raven-dev-password        # postgres superuser password for the compose stack
MINIO_ROOT_USER=raven-dev-access-key        # must match S3_ACCESS_KEY_ID
MINIO_ROOT_PASSWORD=raven-dev-secret-key    # must match S3_SECRET_ACCESS_KEY
PUBLIC_HOSTNAME=localhost                   # hostname Caddy serves (TLS is automatic off localhost)
NEXUS_VERSION=dev                           # image tag to run

# --- client (VITE_ prefix, shipped in the browser bundle — never a secret) --
VITE_APP_MODE=local                         # must match APP_MODE; the bundle is built for one shape
VITE_API_URL=http://localhost:3001          # API base URL used by the SPA (server mode only)
VITE_PUBLIC_APP_URL=http://localhost:5173   # canonical app URL used for redirects
