// Raven — P1 schema. Only the tables P1 needs (20_ROADMAP.md P1 §5.5); the graph projection,
// integrations and AI tables land in their own phases (08_DATA_MODEL.md §4).
//
// Conventions:
//  - `id` is a cuid2 generated in application code (@nexus/domain `newId.*`), never by the DB.
//  - every model carries createdAt/updatedAt; `updatedAt` is written by the app via @updatedAt.
//  - columns are snake_case (@map), tables snake_case plural (@@map).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgRole {
  owner
  admin
  editor
  viewer

  @@map("org_role")
}

model Organization {
  id        String    @id
  slug      String    @unique @db.VarChar(60)
  name      String    @db.VarChar(200)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  members   Membership[]
  projects  Project[]
  auditLogs AuditLog[]
  files     File[]
  runs      IntegrationRun[]
  proposals ImportProposal[]
  consents  Consent[]
  apiTokens ApiToken[]
  aiActions AiAction[]
  settings  WorkspaceSetting[]

  @@map("organizations")
}

/// Better-Auth owns email/emailVerified/name/image; the rest is Raven profile data.
model User {
  id            String    @id
  email         String    @unique @db.VarChar(320)
  emailVerified Boolean   @default(false) @map("email_verified")
  name          String    @db.VarChar(200)
  image         String?   @db.VarChar(2000)
  locale        String    @default("en") @db.VarChar(16)
  timezone      String    @default("UTC") @db.VarChar(64)
  lastSeenAt    DateTime? @map("last_seen_at")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  memberships Membership[]
  sessions    Session[]
  accounts    Account[]
  auditLogs   AuditLog[]
  runs        IntegrationRun[]
  consents    Consent[]
  apiTokens   ApiToken[]

  @@index([lastSeenAt])
  @@map("users")
}

model Membership {
  id        String    @id
  orgId     String    @map("org_id")
  userId    String    @map("user_id")
  role      OrgRole
  invitedBy String?   @map("invited_by")
  joinedAt  DateTime? @map("joined_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Better-Auth session table (field names per Better-Auth's Prisma adapter).
model Session {
  id        String   @id
  userId    String   @map("user_id")
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(400)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Better-Auth account table: one row per credential (providerId 'credential') or OAuth link.
model Account {
  id                    String    @id
  userId                String    @map("user_id")
  accountId             String    @map("account_id") @db.VarChar(255)
  providerId            String    @map("provider_id") @db.VarChar(64)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?   @db.VarChar(1000)
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Project {
  id          String    @id
  orgId       String    @map("org_id")
  key         String    @db.VarChar(24)
  name        String    @db.VarChar(200)
  description String?   @db.VarChar(2000)
  color       String?   @db.VarChar(40)
  icon        String?   @db.VarChar(32)
  archivedAt  DateTime? @map("archived_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  org      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  boards   Board[]
  files    File[]
  runs     IntegrationRun[]
  aiChunks AiChunk[]

  @@unique([orgId, key])
  @@index([orgId, archivedAt])
  @@index([orgId, deletedAt, name])
  @@map("projects")
}

model Board {
  id               String    @id
  orgId            String    @map("org_id")
  projectId        String    @map("project_id")
  title            String    @db.VarChar(300)
  description      String?   @db.VarChar(2000)
  icon             String?   @db.VarChar(32)
  schemaVersion    Int       @default(1) @map("schema_version")
  /// The board (built-in template id or another board's id) this one was created from.
  templateOf       String?   @map("template_of")
  /// Flagged reusable via "save as template" (P7 §5.4); ordinary boards otherwise.
  isTemplate       Boolean   @default(false) @map("is_template")
  archivedAt       DateTime? @map("archived_at")
  lastOpenedAt     DateTime? @map("last_opened_at")
  /// Denormalized counters (P7 §5.1), kept fresh by the sync projection (P8); the client's own
  /// `reportCounts` call remains a clamped fallback for boards not yet backed by the projector.
  nodeCount        Int       @default(0) @map("node_count")
  edgeCount        Int       @default(0) @map("edge_count")
  lastEditedAt     DateTime? @map("last_edited_at")
  /// P8 5.4/5.7: bumped by the projector on every successful projection; a board whose
  /// lastProjectedAt falls far behind lastEditedAt is flagged stale in the admin view.
  lastProjectedAt  DateTime? @map("last_projected_at")
  projectionFailed Boolean   @default(false) @map("projection_failed")
  deletedAt        DateTime? @map("deleted_at")
  createdBy        String    @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  nodes     BoardProjectionNode[]
  edges     BoardProjectionEdge[]
  snapshots BoardSnapshot[]
  comments  Comment[]
  presence  PresenceLogEntry[]

  @@index([projectId, deletedAt])
  @@index([projectId, archivedAt, lastOpenedAt(sort: Desc)])
  @@index([orgId, lastEditedAt(sort: Desc)])
  @@map("boards")
}

/// The queryable projection of one board's Y.Doc `nodes` map (08_DATA_MODEL.md 5, P8 3).
/// Written only by the sync-service projector, never by application code
/// (`no-direct-projection-write`); the CRDT snapshot below remains authoritative.
model BoardProjectionNode {
  id           String    @id
  boardId      String    @map("board_id")
  type         String    @db.VarChar(64)
  title        String    @db.VarChar(500)
  x            Float
  y            Float
  tags         String[]
  status       String    @db.VarChar(16)
  data         Json      @default("{}")
  /// Copied from the doc entry; guards out-of-order projection writes (08 5.3).
  version      Int
  docUpdatedAt DateTime  @map("doc_updated_at")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, deletedAt])
  @@map("nodes")
}

/// The queryable projection of one board's Y.Doc `edges` map.
model BoardProjectionEdge {
  id           String    @id
  boardId      String    @map("board_id")
  type         String    @db.VarChar(64)
  sourceNodeId String    @map("source_node_id")
  targetNodeId String    @map("target_node_id")
  status       String    @db.VarChar(16)
  data         Json      @default("{}")
  version      Int
  docUpdatedAt DateTime  @map("doc_updated_at")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, deletedAt])
  @@index([boardId, sourceNodeId])
  @@index([boardId, targetNodeId])
  @@map("edges")
}

/// The CRDT's durable bytes (P8 7 / 00_MASTER.md 2.2). The binary is authoritative; the
/// projection rows above are disposable and rebuilt from this by `scripts/reproject.ts`.
model BoardSnapshot {
  id          String   @id
  boardId     String   @map("board_id")
  seq         Int
  binary      Bytes
  stateVector Bytes    @map("state_vector")
  /// 'current' is overwritten every store cycle; 'daily' is retained per P8 7 (last 10 + 30 days).
  kind        String   @default("current") @db.VarChar(16)
  createdAt   DateTime @default(now()) @map("created_at")

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([boardId, seq])
  @@index([boardId, kind, createdAt(sort: Desc)])
  @@map("board_snapshots")
}

/// Comment threads (P8 5.10): stored in Postgres, not the CRDT, because they need server-side
/// notification and permission queries. The doc only holds the anchor id (`comments` Y.Map),
/// so a pin moves with its node without a round trip here.
model Comment {
  id         String    @id
  boardId    String    @map("board_id")
  /// Thread replies point at the thread's head comment; null for the head itself.
  parentId   String?   @map("parent_id")
  /// `{ kind: 'node', nodeId }` or `{ kind: 'point', x, y }` (P8 5.10).
  anchor     Json
  body       String    @db.VarChar(8000)
  authorId   String    @map("author_id")
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  board   Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([boardId, resolvedAt])
  @@index([parentId])
  @@map("comments")
}

/// Append-only connect/leave events (P8 5.1/5.12) - presence itself is awareness, never
/// persisted; this is the audit trail eviction and admin tooling read.
model PresenceLogEntry {
  id      String   @id
  boardId String   @map("board_id")
  userId  String   @map("user_id")
  event   String   @db.VarChar(16) // 'join' | 'leave'
  at      DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, at(sort: Desc)])
  @@map("presence_log")
}

/// Append-only. There is no update or delete path in application code (15_SECURITY.md C-42).
model AuditLog {
  id         String   @id
  orgId      String   @map("org_id")
  actorId    String?  @map("actor_id")
  actorKind  String   @map("actor_kind") @db.VarChar(12)
  action     String   @db.VarChar(64)
  targetKind String   @map("target_kind") @db.VarChar(32)
  targetId   String?  @map("target_id")
  ip         String?  @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(400)
  metadata   Json     @default("{}")
  outcome    String   @db.VarChar(16)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt(sort: Desc)])
  @@index([orgId, action, createdAt(sort: Desc)])
  @@index([actorId])
  @@index([targetId])
  @@map("audit_log")
}

enum FileState {
  pending
  scanning
  ready
  failed
  quarantined

  @@map("file_state")
}

/// Uploaded blob metadata. The bytes live in S3 under `key`; this row is the only authority on
/// state, provenance and derivatives (09_BACKEND.md §7).
model File {
  id             String    @id
  orgId          String    @map("org_id")
  projectId      String    @map("project_id")
  boardId        String?   @map("board_id")
  filename       String    @db.VarChar(255)
  mime           String    @db.VarChar(255)
  kind           String    @db.VarChar(16)
  bytes          BigInt
  sha256         String?   @db.VarChar(64)
  storageKey     String    @map("storage_key") @db.VarChar(1024)
  state          FileState @default(pending)
  failureCode    String?   @map("failure_code") @db.VarChar(64)
  failureMessage String?   @map("failure_message") @db.VarChar(500)
  thumbKey       String?   @map("thumb_key") @db.VarChar(1024)
  previewKey     String?   @map("preview_key") @db.VarChar(1024)
  pageCount      Int?      @map("page_count")
  width          Int?
  height         Int?
  deletedAt      DateTime? @map("deleted_at")
  createdBy      String    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, deletedAt, createdAt(sort: Desc)])
  @@index([orgId, sha256, state])
  @@map("files")
}

// ---------------------------------------------------------------------------------------------
// P9 — integration framework (10_INTEGRATIONS.md §5, §12.1; 09_BACKEND.md §4.1).
// Every table here is tenant-scoped by org_id (and project_id where a run belongs to a project),
// the same scoping every other tenant table uses, so the RLS grants in 15_SECURITY.md §3.4 apply
// unchanged. Run rows outlive artifacts and proposals on purpose: they are the provenance backbone.

enum RunStatus {
  queued
  awaiting_approval
  starting
  running
  parsing
  succeeded
  partial
  failed
  cancelled
  timed_out

  @@map("run_status")
}

/// One execution of one integration. `input` is redacted (secretRef fields hold the secret *name*).
model IntegrationRun {
  id             String    @id
  orgId          String    @map("org_id")
  projectId      String    @map("project_id")
  boardId        String    @map("board_id")
  integrationId  String    @map("integration_id") @db.VarChar(64)
  adapterVersion String    @map("adapter_version") @db.VarChar(40)
  toolVersion    String    @map("tool_version") @db.VarChar(40)
  imageDigest    String?   @map("image_digest") @db.VarChar(80)
  actorUserId    String    @map("actor_user_id")
  anchorNodeId   String?   @map("anchor_node_id")
  input          Json
  /// sha256 of the canonical JSON input; the re-run dedupe key (§7.5).
  inputHash      String    @map("input_hash") @db.VarChar(64)
  targets        Json
  consentId      String?   @map("consent_id")
  status         RunStatus
  attempt        Int       @default(1)
  exitCode       Int?      @map("exit_code")
  errorCode      String?   @map("error_code") @db.VarChar(48)
  errorDetail    Json?     @map("error_detail")
  startedAt      DateTime? @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  durationMs     Int?      @map("duration_ms")
  stats          Json      @default("{}")
  artifacts      Json      @default("[]")
  proposalId     String?   @map("proposal_id")
  appliedAt      DateTime? @map("applied_at")
  parentRunId    String?   @map("parent_run_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  org        Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor      User             @relation(fields: [actorUserId], references: [id])
  consent    Consent?         @relation(fields: [consentId], references: [id])
  proposal   ImportProposal?  @relation("RunProposal", fields: [proposalId], references: [id])
  parentRun  IntegrationRun?  @relation("RunReruns", fields: [parentRunId], references: [id])
  reruns     IntegrationRun[] @relation("RunReruns")
  logEntries RunLogEntry[]
  proposals  ImportProposal[] @relation("ProposalRun")

  @@index([projectId, createdAt(sort: Desc)])
  @@index([boardId, createdAt(sort: Desc)])
  @@index([integrationId, inputHash, createdAt(sort: Desc)])
  @@index([orgId, status])
  @@map("integration_runs")
}

/// The rendered run log (§6.10). 90-day retention; pruned by the same sweeper as presence logs.
model RunLogEntry {
  runId   String   @map("run_id")
  seq     Int
  at      DateTime
  level   String   @db.VarChar(8)
  phase   String   @db.VarChar(16)
  message String   @db.VarChar(2000)
  data    Json?

  run IntegrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@id([runId, seq])
  @@map("run_log_entries")
}

/// The reviewable result of a run (§3.7). Immutable except `appliedItems`; expires after 7 days.
model ImportProposal {
  id            String    @id
  orgId         String    @map("org_id")
  projectId     String    @map("project_id")
  boardId       String    @map("board_id")
  runId         String    @map("run_id")
  integrationId String    @map("integration_id") @db.VarChar(64)
  payload       Json
  summary       Json      @default("{}")
  /// itemId → created entity id; makes apply idempotent per (proposalId, itemId) (§3.8 point 4).
  appliedItems  Json      @default("{}") @map("applied_items")
  appliedAt     DateTime? @map("applied_at")
  appliedBy     String?   @map("applied_by")
  discardedAt   DateTime? @map("discarded_at")
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  org  Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run  IntegrationRun   @relation("ProposalRun", fields: [runId], references: [id], onDelete: Cascade)
  runs IntegrationRun[] @relation("RunProposal")

  @@index([boardId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("import_proposals")
}

/// Recorded authorization for a scoped run (§12.1). Proves *which wording* was shown, and when.
model Consent {
  id            String    @id
  orgId         String    @map("org_id")
  projectId     String    @map("project_id")
  userId        String    @map("user_id")
  integrationId String    @map("integration_id") @db.VarChar(64)
  scope         String    @db.VarChar(24)
  targetsHash   String    @map("targets_hash") @db.VarChar(64)
  scopeTextHash String    @map("scope_text_hash") @db.VarChar(64)
  acceptedAt    DateTime  @map("accepted_at")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  usedAt        DateTime? @map("used_at")
  ip            String?   @db.VarChar(45)
  userAgent     String?   @map("user_agent") @db.VarChar(400)
  createdAt     DateTime  @default(now()) @map("created_at")

  org  Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs IntegrationRun[]

  @@index([projectId, integrationId, userId, expiresAt])
  @@map("consents")
}

/// Scoped API tokens for the REST v1 surface (09_BACKEND.md §4.1). Only the argon2id hash is
/// stored; the plaintext is shown once at creation and can never be retrieved again.
model ApiToken {
  id         String    @id
  orgId      String    @map("org_id")
  userId     String    @map("user_id")
  name       String    @db.VarChar(120)
  /// First 12 characters of the token, for "which token is this?" in the UI. Not a secret.
  prefix     String    @db.VarChar(16)
  hash       String    @db.VarChar(255)
  scopes     String[]
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([prefix])
  @@index([orgId, userId])
  @@map("api_tokens")
}

/// One `RepositoryAnalysis` (11_GITHUB.md §5.10). Keyed by repo + head SHA + analyzer version, so a
/// re-analysis of an unchanged head is a cache hit and old rows stay for the "what changed" diff.
/// `proposal` holds the draft Integration Proposal (§6) built from this analysis, when eligible.
model GithubAnalysis {
  id              String   @id
  repoKey         String   @map("repo_key") @db.VarChar(255)
  headSha         String   @map("head_sha") @db.VarChar(64)
  analyzerVersion String   @map("analyzer_version") @db.VarChar(32)
  payload         Json
  proposal        Json?
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([repoKey, headSha, analyzerVersion])
  @@index([repoKey, createdAt(sort: Desc)])
  @@map("github_analyses")
}

/// A tracked source repository (§27). One row per canonical `host/owner/name`; the per-head
/// analysis rows live in `GithubAnalysis` and point back here by `repoKey`.
model Repository {
  id            String    @id
  /// Canonical `host/owner/name`, lowercased. Matches `GithubAnalysis.repoKey`.
  repoKey       String    @map("repo_key") @db.VarChar(255)
  host          String    @db.VarChar(64)
  owner         String    @db.VarChar(128)
  name          String    @db.VarChar(128)
  defaultBranch String?   @map("default_branch") @db.VarChar(128)
  lastHeadSha   String?   @map("last_head_sha") @db.VarChar(64)
  lastFetchedAt DateTime? @map("last_fetched_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([repoKey])
  @@map("repositories")
}

/// One AI capability run (§16, §27). Proposals only (N4): `output` holds the proposed patch, it is
/// never applied here. Kept for history, cost accounting and cache lookups by `inputHash`.
model AiAction {
  id         String    @id
  orgId      String    @map("org_id")
  projectId  String?   @map("project_id")
  boardId    String?   @map("board_id")
  capability String    @db.VarChar(64)
  model      String    @db.VarChar(120)
  status     String    @db.VarChar(16)
  inputHash  String    @map("input_hash") @db.VarChar(64)
  output     Json?
  error      String?   @db.VarChar(500)
  tokensIn   Int?      @map("tokens_in")
  tokensOut  Int?      @map("tokens_out")
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, startedAt(sort: Desc)])
  @@index([capability, inputHash])
  @@map("ai_actions")
}

/// Org-scoped key/value settings (§27) — AI endpoint, feature toggles, defaults. Values are JSON so
/// a new setting needs no migration; validation lives with the reader, not the table.
model WorkspaceSetting {
  orgId     String   @map("org_id")
  key       String   @db.VarChar(64)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, key])
  @@map("workspace_settings")
}

/// A standing Sherlock watch on one `username` node (13_SHERLOCK.md §6.6). Scheduling rules —
/// cadence, ±10% jitter, 90-day consent expiry, quotas — live in `@nexus/integrations/sherlock/watch`
/// so the API and the worker cannot disagree. A scheduled result is always a pending diff (N4).
model UsernameWatch {
  id        String    @id
  orgId     String    @map("org_id")
  projectId String    @map("project_id")
  nodeId    String    @map("node_id")
  handle    String    @db.VarChar(120)
  createdBy String    @map("created_by")
  cadence   String    @db.VarChar(16)
  /// null = the tool's full site list.
  sites     Json?
  notifyOn  Json      @map("notify_on")
  consentId String    @map("consent_id")
  pausedAt  DateTime? @map("paused_at")
  lastRunId String?   @map("last_run_id")
  nextRunAt DateTime  @map("next_run_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([projectId, nodeId])
  @@index([nextRunAt])
  @@map("username_watches")
}

/// One retrieval chunk for hybrid search (14_AI_AGENT.md §6.4). `embedding` is pgvector — Prisma
/// cannot express its HNSW index or the lexical expression index, so both live only in the
/// migration SQL. `content_hash` makes re-embedding idempotent; `model` is part of the unique key
/// so two embedding generations can coexist during a model migration.
model AiChunk {
  id          String                       @id
  projectId   String                       @map("project_id")
  boardId     String?                      @map("board_id")
  nodeId      String                       @map("node_id")
  kind        String                       @db.VarChar(16)
  ord         Int
  text        String
  tokenCount  Int                          @map("token_count")
  contentHash String                       @map("content_hash") @db.VarChar(64)
  model       String                       @db.VarChar(120)
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime                     @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([nodeId, kind, ord, model])
  @@index([projectId, nodeId])
  @@map("ai_chunks")
}

/// Envelope-encrypted org credentials (15_SECURITY.md §8.2): GitHub PAT, SpiderFoot key, AI
/// provider key. Write-only by contract — no API returns `ciphertext`, and the UI identifies a
/// credential by `label`, `lastFour` and `fingerprint` only. `encDek` is the DEK wrapped by the
/// KEK, so a KEK rotation re-wraps this column without touching the ciphertext.
model IntegrationCredential {
  id            String    @id
  orgId         String    @map("org_id")
  /// null = the credential is org-wide rather than scoped to one project.
  projectId     String?   @map("project_id")
  integrationId String    @map("integration_id")
  label         String    @db.VarChar(120)
  encDek        Bytes     @map("enc_dek")
  nonce         Bytes
  ciphertext    Bytes
  keyVersion    Int       @map("key_version")
  /// sha256(plaintext) prefix — answers "is this the same key?" without decrypting.
  fingerprint   String    @db.VarChar(32)
  lastFour      String?   @map("last_four") @db.VarChar(8)
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastUsedAt    DateTime? @map("last_used_at")
  rotatedAt     DateTime? @map("rotated_at")
  expiresAt     DateTime? @map("expires_at")

  @@unique([orgId, integrationId, label])
  @@index([orgId, integrationId])
  @@map("integration_credentials")
}
